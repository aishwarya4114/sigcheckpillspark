# Copy to .env (git-ignored) and fill in. Never commit real keys.
NICRRON_API_KEY=
NICRRON_BASE_URL=https://api.nicrron.ai/v1
NICRRON_READER_MODEL=anthropic/claude-sonnet-5
# optional second, independent reader from a different vendor (leave empty to disable)
NICRRON_SECOND_READER_MODEL=

PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
PRISMTRACE_HOST=https://api.prism.blockconvey.com
